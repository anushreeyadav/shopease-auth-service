{
  "info": {
    "name": "ShopEase Auth Service",
    "description": "The 22 mandatory API scenarios. Dummy credentials only. Run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A new number for each run, so that test emails do not collide.",
          "if (!pm.collectionVariables.get(\"run_id\")) { pm.collectionVariables.set(\"run_id\", String(Date.now())); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register the main test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test User\",\n  \"email\": \"postman.{{run_id}}@example.com\",\n  \"password\": \"Test!Pass123\",\n  \"confirm_password\": \"Test!Pass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "var text = pm.response.text();",
                  "pm.test(\"No password data returned\", function () { pm.expect(text).to.not.include(\"password_hash\"); pm.expect(text).to.not.match(/\\$2[aby]\\$/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in and save the token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.{{run_id}}@example.com\",\n  \"password\": \"Test!Pass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "var text = pm.response.text();",
                  "pm.test(\"No password data returned\", function () { pm.expect(text).to.not.include(\"password_hash\"); pm.expect(text).to.not.match(/\\$2[aby]\\$/); });",
                  "if (pm.response.code === 200) { pm.environment.set(\"access_token\", pm.response.json().access_token); }"
                ]
              }
            }
          ]
        }
      ]
    },
