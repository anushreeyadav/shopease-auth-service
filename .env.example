# Copy to .env for local development:  Copy-Item .env.example .env
# Then replace every change-me value. The service refuses to start with a placeholder secret.
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(64))"

APP_NAME=ShopEase Auth Service
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api
DOCS_ENABLED=true

# Database. The MySQL container is also created from these values.
MYSQL_DATABASE=shopease_auth_db
MYSQL_USER=auth_svc
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
# Port on this machine. Inside Docker, the service always uses auth-mysql:3306.
MYSQL_PORT=3308
# Used only by the MySQL container.
MYSQL_ROOT_PASSWORD=change-me

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Port on this machine for the containerised service (docker-compose.yml).
AUTH_SERVICE_HOST_PORT=8001
